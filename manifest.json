{
    "manifest_version": 3,
    "name": "OverLook",
    "version": "1.2",
    "description": "Capture any screen area and overlay it on the page. Adjust opacity, rotation, and size to compare designs or references.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_title": "OverLook",
        "default_icon": {
            "16": "icons/pageview16.png",
            "48": "icons/pageview48.png",
            "128": "icons/pageview128.png"
        }
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "icons": {
        "16": "icons/pageview16.png",
        "48": "icons/pageview48.png",
        "128": "icons/pageview128.png"
    }
}
